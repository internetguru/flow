#!/usr/bin/env butt

function take {
  cd "${curdir}" \
    && rm -rf "${1}" \
    && mkdir "${1}" \
    && cd "${1}" \
    || exit 2
}

# make git return only error to stderr
function gch {
  local out
  out="$(git checkout "$@" 2>&1)" \
    || err "${out}"
}

function git_current_branch {
  git rev-parse --abbrev-ref HEAD
}

function gsp {
  git status --porcelain
}

function checkInitRefs {
  assert_equal "$(git show-ref | wc -l)" 5
  assert_contains "$(git show-ref)" "refs/heads/dev"
  assert_contains "$(git show-ref)" "refs/heads/${1:-main}"
  assert_contains "$(git show-ref)" "refs/heads/staging"
  assert_contains "$(git show-ref)" "refs/heads/${1:-main}-0"
  assert_contains "$(git show-ref)" "refs/tags/v0.0.0"
}

function checkInitFiles {
  assert_equal "$(git show dev:VERSION)" "0.1.0"
  assert_equal "$(git show "${1:-main}":VERSION)" "0.0.0"
  assert_equal "$(git show staging:VERSION)" "0.0.0"
  assert_equal "$(git show "${1:-main}"-0:VERSION)" "0.0.0"
  assert_equal "$(head -n1 CHANGELOG.md)" "# Change Log"
}

function grep_log {
  git log --no-color --oneline --decorate --all | grep --quiet "${1}"
}

function load_log {
  log="$(git log --no-color --oneline --decorate --all)"
  IFS=$'\n' read -d '' -r -a loglines <<< "${log}" || return 0
}

export FLOW_OPTIONS=""
export COLUMNS=1000
export MANWIDTH=1000

#local i curdir ref log loglines chglog chgloglines
i=0
curdir="$(pwd)"
ref=
log=
loglines=()
outlines=()
errlines=()
status=

#######################################
## Integration
#######################################
# TODO test flow help on macOs, now it is skipped due to issue https://github.com/InternetGuru/flow/issues/66
: $((i++))
start "flow help"
  take "${i}"
  debug "flow --help"
  assert_equal "${status}" 0
  assert_startwith "${outlines[0]}" "Usage: flow [-"
  assert_startwith "${outlines[1]}" "  -c, --conform"
  debug "flow -n"
  assert_equal "${status}" 3
end
#######################################
: $((i++))
start "flow --version shows version"
  take "${i}"
  debug "flow --version"
  assert_equal "${status}" 0
  assert_startwith "${outlines[0]}" "flow "
  debug "flow -n"
  assert_equal "${status}" 3
end
#######################################
: $((i++))
start "flow -V shows version"
  take "${i}"
  debug "flow -V"
  assert_equal "${status}" 0
  assert_startwith "${outlines[0]}" "flow "
  debug "flow -n"
  assert_equal "${status}" 3
end
#######################################
: $((i++))
start "no tput errors without a terminal type"
  take "${i}"
  debug "env -u TERM -u LINES -u COLUMNS flow -V"
  assert_equal "${status}" 0
  assert_equal "${stderr}" ""
  { flow -iy \
    && gch main \
    && git branch -D dev
  } >/dev/null 2>&1
  debug "env -u TERM flow"
  assert_equal "${status}" 3
  assert_equal "${errlines[0]}" "flow: Local branch 'dev' not found."
  assert_equal "${#errlines[@]}" 2
end
#######################################
## Error codes
#######################################
: $((i++))
start "invalid option error code"
  take "${i}"
  debug "flow --invalid-option"
  assert_equal "${status}" 2
  assert_contains "${errlines[0]}" "unrecognized option"
  debug "flow -n"
  assert_equal "${status}" 3
end
#######################################
: $((i++))
start "missing git error code"
  take "${i}"
  debug "flow"
  assert_equal "${status}" 3
  # shellcheck disable=SC2154
  assert_contains "${errlines[0]}" "Git repository not found."
end
#######################################
: $((i++))
start "missing branch dev error code"
  take "${i}"
  { flow -iy \
    && gch main \
    && git branch -D dev
  } >/dev/null 2>&1
  debug "flow"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Local branch 'dev' not found."
end
#######################################
: $((i++))
start "missing VERSION file error code"
  take "${i}"
  { flow -iy \
    && rm VERSION \
    && git commit -am "delete VERSION file"
  } >/dev/null
  debug "flow"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Missing or invalid version file on dev."
end
#######################################
: $((i++))
start "dev is behind main error code"
  take "${i}"
  { flow -iy \
    && echo a > a \
    && git add a \
    && git commit -am "add file a" \
    && flow --yes \
    && flow --yes \
    && gch dev \
    && git reset --hard HEAD~1
  } >/dev/null
  debug "flow -v"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Branch 'main' is not merged into 'dev'."
end
#######################################
: $((i++))
start "invalid changelog on dev"
  take "${i}"
  { flow -iy \
    && echo a > CHANGELOG.md \
    && git commit -am "break changelog"
  } >/dev/null
  debug "flow"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Missing or invalid changelog file on dev."
end
#######################################
: $((i++))
start "uncommitted changes error code"
  take "${i}"
  { flow -iy \
    && echo a > a
  } >/dev/null
  debug "flow"
  assert_equal "${status}" 5
  assert_contains "${errlines[0]}" "Uncommitted changes."
end
#######################################
: $((i++))
start "version change on dev"
  take "${i}"
  { flow -iy \
    && echo 1.0.0 > VERSION \
    && git commit -am "bump version" \
    && flow --yes --branch main \
    && echo a > a \
    && git add . \
    && git commit -am "fix a"
  } >/dev/null
  debug "echo '' | flow --yes"
  assert_equal "${status}" 0
  load_log
  assert_contains "${log}" "(HEAD -> dev) Merge branch 'main' into dev"
  assert_contains "${log}" "(tag: v0.0.1, staging, main-0, main) Merge branch 'hotfix-$(whoami)'"
  assert_contains "${log}" "Merge branch 'main' into dev"
  assert_equal "$(git show main:VERSION)" "0.0.1"
  assert_equal "$(git show staging:VERSION)" "0.0.1"
  assert_equal "$(git show dev:VERSION)" "1.0.0"
  assert_equal "$(git show-ref | grep /refs/heads/hotfix-$(whoami))" ""
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
## Dry run
#######################################
: $((i++))
start "dry run"
  take "${i}"
  debug "flow --dry-run"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Git repository not found."
end
#######################################
: $((i++))
start "dry run and invalid option"
  take "${i}"
  debug "flow --dry-run --invalid-option"
  assert_equal "${status}" 2
  assert_contains "${errlines[0]}" "unrecognized option"
end
#######################################
## Init
#######################################
: $((i++))
start "init on empty folder"
  take "${i}"
  debug "flow --init --yes"
  assert_equal "${status}" 0
  checkInitFiles
  checkInitRefs
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "init on non-empty folder"
  take "${i}"
  { touch a \
    && touch b
  } >/dev/null
  debug "flow --init --yes"
  assert_equal "${status}" 5
  assert_contains "${errlines[0]}" "Folder is not empty."
end
#######################################
: $((i++))
start "force init on non-empty folder"
  take "${i}"
  { touch a; } >/dev/null
  debug "flow --init --yes --force"
  assert_equal "${status}" 0
  checkInitFiles
  assert_equal "$(git show-ref | wc -l)" 5
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
: $((i++))
start "init on existing repo with commits"
  take "${i}"
  { git init -b master \
    && echo a > a \
    && git add . \
    && git commit -am "first commit.."
  } >/dev/null
  debug "flow -v --init --yes"
  assert_equal "${status}" 0
  checkInitFiles master
  checkInitRefs master
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "init on existing repo uncommitted"
  take "${i}"
  { git init \
    && echo a > a
  } >/dev/null
  debug "flow -v --init --yes"
  assert_equal "${status}" 5
  assert_contains "${errlines[0]}" "Folder is not empty."
end
#######################################
: $((i++))
start "force init on existing repo without commits"
  take "${i}"
  { git init -b master \
    && echo a > a
  } >/dev/null
  debug "flow -v --init --yes --force"
  assert_equal "${status}" 0
  checkInitFiles master
  assert_equal "$(git show-ref | wc -l)" 5
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
## Conform
#######################################
: $((i++))
start "conform on empty folder"
  take "${i}"
  debug "yes no | flow --conform --yes"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Git repository not found."
end
#######################################
: $((i++))
start "conform on existing repo without commits"
  take "${i}"
  { git init \
    && echo a > a
  } >/dev/null
  debug "flow --conform --yes"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Missing initial commit."
end
#######################################
: $((i++))
start "force init on existing repo with commits"
  take "${i}"
  { git init -b master \
    && echo a > a \
    && git add . \
    && git commit -am "first commit" \
    && echo b > b
  } >/dev/null
  debug "flow --init --yes --force"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "dev"
  checkInitFiles master
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
: $((i++))
start "force conform on existing repo with commits"
  take "${i}"
  { git init -b main \
    && echo a > a \
    && git add . \
    && git commit -am "first commit" \
    && echo b > b
  } >/dev/null
  debug "flow --conform --force --yes"
  assert_equal "${status}" 0
  assert_equal "$(git show-ref | wc -l)" 6
  assert_equal "$(git_current_branch)" "hotfix-$(whoami)"
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
## Feature
#######################################
: $((i++))
start "create feature"
  take "${i}"
  { flow --init --yes; } >/dev/null
  debug "flow -v --yes myfeature"
  assert_equal "${status}" 0
  assert_contains "$(git show-ref)" "refs/heads/myfeature"
  assert_equal "$(git rev-parse myfeature)" "$(git rev-parse dev)"
  assert_equal "$(git_current_branch)" "myfeature"
  debug "flow -n"
  assert_equal "${status}" 6
end
#######################################
: $((i++))
start "force create feature with uncommited changes"
  take "${i}"
  { flow --init --yes \
    && echo a > a
  } >/dev/null
  debug "flow -v --yes --force myfeature"
  assert_equal "${status}" 0
  assert_equal "$(git show-ref | wc -l)" 6
  assert_contains "${outlines[0]}" "Stashing files"
  assert_equal "$(git_current_branch)" "myfeature"
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
: $((i++))
start "merge feature"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -am "add feature 1"
  } >/dev/null
  debug "echo 'feature1' | flow --yes"
  assert_equal "${status}" 0
  load_log
  assert_contains "${log}" "Update changelog"
  assert_contains "${loglines[0]}" "(HEAD -> dev) Merge branch 'myfeature' into dev"
  assert_equal "$(git show-ref | grep /refs/heads/feature-myfeature)" ""
  assert_equal "$(git show dev:CHANGELOG.md | head -9 | tail -1)" "### Added"
  assert_equal "$(git show dev:CHANGELOG.md | head -11 | tail -1)" "- feature1"
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "merge feature with own changelog entry"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature \
    && echo a > a \
    && sed -i 's/^## \[Unreleased\]$/&\n\n### Added\n\n- my entry/' CHANGELOG.md \
    && git add . \
    && git commit -am "add feature 1"
  } >/dev/null
  debug "flow --yes </dev/null"
  assert_equal "${status}" 0
  assert_equal "$(echo "${stdout}" | grep -c "description for")" 0
  assert_equal "$(git log --oneline dev | grep -c "Update changelog$")" 0
  assert_equal "$(git show dev:CHANGELOG.md | grep -c '^- my entry$')" 1
  assert_equal "$(git show dev:CHANGELOG.md | grep -c "New feature")" 0
  assert_equal "$(gsp)" ""
end
#######################################
: $((i++))
start "merge feature with own changelog entry and --changelog=always"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature \
    && echo a > a \
    && sed -i 's/^## \[Unreleased\]$/&\n\n### Added\n\n- my entry/' CHANGELOG.md \
    && git add . \
    && git commit -am "add feature 1"
  } >/dev/null
  debug "echo 'feature1' | flow --yes --changelog=always"
  assert_equal "${status}" 0
  assert_equal "$(git show dev:CHANGELOG.md | grep -c '^- my entry$')" 1
  assert_equal "$(git show dev:CHANGELOG.md | grep -c '^- feature1$')" 1
end
#######################################
: $((i++))
start "merge feature with --changelog=never"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -am "add feature 1"
  } >/dev/null
  debug "flow --yes --changelog=never </dev/null"
  assert_equal "${status}" 0
  assert_contains "$(git log --oneline -1 dev)" "Merge branch 'myfeature' into dev"
  assert_equal "$(git log --oneline dev | grep -c "Update changelog$")" 0
  assert_equal "$(git show dev:CHANGELOG.md | grep -c "New feature")" 0
  assert_equal "$(gsp)" ""
end
#######################################
: $((i++))
start "merge feature with -lnever"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -am "add feature 1"
  } >/dev/null
  debug "flow --yes -lnever </dev/null"
  assert_equal "${status}" 0
  assert_equal "$(git log --oneline dev | grep -c "Update changelog$")" 0
  assert_equal "$(git show dev:CHANGELOG.md | grep -c "New feature")" 0
end
#######################################
: $((i++))
start "invalid changelog value"
  take "${i}"
  { flow --init --yes; } >/dev/null
  debug "flow --changelog=foo"
  assert_equal "${status}" 2
  assert_contains "${errlines[0]}" "Unknown changelog value"
  debug "flow --changelog=NEVER"
  assert_equal "${status}" 2
  assert_contains "${errlines[0]}" "Unknown changelog value"
end
#######################################
: $((i++))
start "merge hotfix with own changelog entry"
  take "${i}"
  { flow --init --yes \
    && flow --yes --branch main \
    && echo a > a \
    && sed -i '0,/^## \[/s//## [Unreleased]\n\n### Fixed\n\n- my fix\n\n&/' CHANGELOG.md \
    && git add . \
    && git commit -am "fix a"
  } >/dev/null
  debug "flow --yes </dev/null"
  assert_equal "${status}" 0
  assert_equal "$(echo "${stdout}" | grep -c "description for")" 0
  assert_contains "$(git show main-0:CHANGELOG.md | grep -m1 '^## ')" "## [0.0.1] - "
  assert_equal "$(git show main-0:CHANGELOG.md | grep -A4 '^## \[0.0.1\]' | tail -1)" "- my fix"
  assert_equal "$(git show main-0:CHANGELOG.md | grep -c "New feature")" 0
  assert_equal "$(gsp)" ""
end
#######################################
: $((i++))
start "verbose merge feature without a terminal"
  take "${i}"
  { flow -iy \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -m "add feature 1"
  } >/dev/null
  debug "echo | flow -v --yes --color=never"
  assert_equal "${status}" 0
  assert_equal "${stderr}" ""
  assert_contains "${stdout}" "Merging 'dev' to 'myfeature' (upwards). [  pass  ]"
end
#######################################
: $((i++))
start "merge empty feature"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature
  } >/dev/null
  debug "flow -v --yes"
  assert_equal "${status}" 6
  assert_contains "${errlines[0]}" "Nothing to merge."
end
#######################################
: $((i++))
start "force merge feature with uncommitted changes"
  take "${i}"
  { flow --init --yes \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -am "add feature 1" \
    && echo b > b
  } >/dev/null
  debug "echo 'feature1' | flow --yes --force"
  assert_equal "${status}" 0
  #assert_contains "${outlines[0]}" "Stashing files"
  load_log
  assert_contains "${log}" "Update changelog"
  assert_contains "${loglines[0]}" "(HEAD -> dev) Merge branch 'myfeature' into dev"
  assert_equal "$(git show-ref | grep /refs/heads/myfeature)" ""
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
: $((i++))
start "pull request url of an https remote"
  take "${i}"
  { git init -q --bare ../"${i}"-origin.git \
    && flow --init --yes \
    && git remote add origin https://github.com/acme/repo.git \
    && git config remote.origin.pushurl ../"${i}"-origin.git \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -qm "add feature 1"
  } >/dev/null 2>&1
  debug "echo | flow --yes --request"
  assert_equal "${status}" 0
  assert_contains "${stdout}" "Pull request URL: https://github.com/acme/repo/compare/dev...myfeature?expand=1"
end
#######################################
## RELEASE
#######################################
: $((i++))
start "create staging"
  take "${i}"
  { flow --init --yes \
    && echo a > a \
    && git add . \
    && git commit -m "add file a"
  } >/dev/null
  debug "flow -v --yes"
  assert_equal "${status}" 0
  assert_equal "$(git show dev:VERSION)" "0.2.0"
  assert_equal "$(git show staging:VERSION)" "0.1.0"
  assert_equal "$(git show dev:CHANGELOG.md | head -7 | tail -1)" "## [Unreleased]"
  assert_contains "$(git show dev:CHANGELOG.md | head -9 | tail -1)" "## [0.1.0-rc.1] - "
  assert_contains "$(git show staging:CHANGELOG.md | head -7 | tail -1)" "## [0.1.0-rc.1] - "
  assert_contains "$(git show-ref)" "refs/heads/staging"
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "create rc2"
  take "${i}"
  { flow --init --yes \
    && flow -y -b dev
  } >/dev/null
  debug "flow -y -b dev"
  assert_equal "${status}" 0
  assert_equal "$(git show dev:VERSION)" "0.2.0"
  assert_equal "$(git show staging:VERSION)" "0.1.0"
  assert_equal "$(git show dev:CHANGELOG.md | head -7 | tail -1)" "## [Unreleased]"
  assert_contains "$(git show dev:CHANGELOG.md | head -9 | tail -1)" "## [0.1.0-rc.2] - "
  assert_contains "$(git show dev:CHANGELOG.md | head -11 | tail -1)" "## [0.1.0-rc.1] - "
  assert_contains "$(git show staging:CHANGELOG.md | head -7 | tail -1)" "## [0.1.0-rc.2] - "
  assert_contains "$(git show staging:CHANGELOG.md | head -9 | tail -1)" "## [0.1.0-rc.1] - "
  assert_contains "$(git show-ref)" "refs/heads/staging"
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "release rc2"
  take "${i}"
  { flow --init --yes \
    && flow -y -b dev \
    && flow -y -b dev
  } >/dev/null
  debug "flow -y"
  assert_equal "${status}" 0
  assert_equal "$(git show dev:VERSION)" "0.2.0"
  assert_equal "$(git show staging:VERSION)" "0.1.0"
  assert_equal "$(git show dev:CHANGELOG.md | head -7 | tail -1)" "## [Unreleased]"
  assert_contains "$(git show dev:CHANGELOG.md | head -9 | tail -1)" "## [0.1.0] - "
  assert_contains "$(git show dev:CHANGELOG.md | head -13 | tail -1)" "## [0.1.0-rc.2] - "
  assert_contains "$(git show dev:CHANGELOG.md | head -15 | tail -1)" "## [0.1.0-rc.1] - "
  assert_contains "$(git show main:CHANGELOG.md | head -7 | tail -1)" "## [0.1.0] - "
  assert_contains "$(git show main:CHANGELOG.md | head -11 | tail -1)" "## [0.1.0-rc.2] - "
  assert_contains "$(git show main:CHANGELOG.md | head -13 | tail -1)" "## [0.1.0-rc.1] - "
  assert_contains "$(git show-ref)" "refs/heads/dev"
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "release an already released staging"
  take "${i}"
  { flow --init --yes \
    && echo a > a \
    && git add . \
    && git commit -m "add file a"
  } >/dev/null
  debug "flow --yes -b staging"
  assert_equal "${status}" 6
  assert_contains "${errlines[0]}" "Staging branch is already released."
  assert_equal "$(git show staging:VERSION)" "0.0.0"
end
#######################################
: $((i++))
start "force staging with uncommited changes"
  take "${i}"
  { flow --init --yes \
    && echo a > a \
    && git add . \
    && git commit -m "add file a" \
    && echo b > b
  } >/dev/null
  debug "flow -v --yes --force"
  assert_equal "${status}" 0
  assert_contains "${outlines[0]}" "Stashing files"
  assert_contains "$(git show-ref)" "refs/heads/staging"
  assert_equal "$(gsp | wc -l)" 1
  debug "flow -n"
  assert_equal "${status}" 5
end
#######################################
: $((i++))
start "merge staging"
  take "${i}"
  { flow --init --yes \
    && echo a > a \
    && git add . \
    && git commit -m "add file a" \
    && flow --yes
  } >/dev/null
  debug "flow -v --yes --branch staging"
  assert_equal "${status}" 0
  assert_equal "$(git show dev:VERSION)" "0.2.0"
  assert_equal "$(git show staging:VERSION)" "0.1.0"
  assert_equal "$(git show main:VERSION)" "0.1.0"
  load_log
  assert_contains "${log}" "(HEAD -> dev) Merge branch 'main' into dev"
  assert_contains "${log}" "(tag: v0.1.0, staging, main-0, main) Merge branch 'staging'"
  assert_contains "${log}" "Update changelog and increment version"
  assert_equal "$(git show-ref | grep /refs/heads/staging)" ""
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "invalid version number"
  take "${i}"
  { flow --init --yes \
    && echo 0.0.0 > VERSION \
    && git commit -am "version"
  } >/dev/null 2>&1
  debug "flow"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Missing or invalid version file on dev."
end
#######################################
: $((i++))
start "invalid version number --conform"
  take "${i}"
  { flow --init --yes \
    && gch staging \
    && echo 1.0.0 > VERSION \
    && git commit -am "version"
  } >/dev/null 2>&1
  debug "flow --conform --yes"
  assert_equal "${status}" 0
  assert_equal "$(cat VERSION)" "1.1.0"
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "unmerged changes on staging"
  take "${i}"
  { flow --init --yes \
    && gch staging \
    && touch a \
    && git add . \
    && git commit -am "a"
  } >/dev/null
  debug "flow --yes -b staging"
  assert_equal "${status}" 3
  assert_contains "${errlines[0]}" "Missing or invalid version file on staging."
end
#######################################
: $((i++))
start "unmerged changes on staging --conform"
  take "${i}"
  { flow --init --yes \
    && gch staging \
    && touch a \
    && git add . \
    && git commit -am "a"
  } >/dev/null
  debug "flow -cy -b staging"
  assert_equal "${status}" 0
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "merge staging with --request"
  take "${i}"
  { git init -q --bare ../"${i}"-origin.git \
    && flow --init --yes \
    && git remote add origin https://github.com/acme/repo.git \
    && git config remote.origin.pushurl ../"${i}"-origin.git \
    && flow --yes
  } >/dev/null 2>&1
  debug "echo | flow --yes --request"
  assert_equal "${status}" 0
  assert_contains "${stdout}" "Pull request URL: https://github.com/acme/repo/compare/main...staging?expand=1"
  assert_equal "$(git show main:VERSION)" "0.0.0"
  assert_equal "$(git -C ../"${i}"-origin.git branch --list staging)" "  staging"
end
#######################################
## HOTFIX
#######################################
: $((i++))
start "hotfix main"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow -v --yes -b main"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "hotfix-$(whoami)"
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 6
end
#######################################
: $((i++))
start "hotfix with --branch on a production branch"
  take "${i}"
  { flow -iy \
   && echo 1.0.0 > VERSION \
   && git commit -am "bump version" \
   && flow -y -b dev \
   && flow -y \
   && gch dev;
  } >/dev/null
  debug "flow --yes -b main-0"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "hotfix-$(whoami)"
  assert_equal "$(git rev-parse HEAD)" "$(git rev-parse main-0)"
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 6
end
#######################################
: $((i++))
start "merge main hotfix"
  take "${i}"
  { flow -iy \
   && gch main \
   && flow --yes myhotfix \
   && echo a > a \
   && git add . \
   && git commit -m "add file a";
  } >/dev/null
  debug "echo '' | flow --yes"
  assert_equal "${status}" 0
  load_log
  assert_contains "${loglines[0]}" "(HEAD -> dev) Merge branch 'main' into dev"
  assert_contains "${log}" "(tag: v0.0.1, staging, main-0, main) Merge branch 'myhotfix'"
  assert_equal "$(git show dev:VERSION)" "0.1.0"
  assert_equal "$(git show staging:VERSION)" "0.0.1"
  assert_equal "$(git show main:VERSION)" "0.0.1"
  assert_equal "$(git show-ref | grep /refs/heads/hotfix-myhotfix)" ""
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "merge hotfix on older major"
  take "${i}"
  { flow -iy \
   && echo 1.0.0 > VERSION \
   && git commit -am "bump version" \
   && flow -y -b dev \
   && flow -y \
   && gch main-0 \
   && flow --yes fix1 \
   && echo a > a \
   && git add . \
   && git commit -m "add file a" \
   && echo '' | flow --yes \
   && gch main-0 \
   && flow --yes \
   && echo b > b \
   && git add . \
   && git commit -m "add file b";
  } >/dev/null
  debug "echo '' | flow --yes"
  assert_equal "${status}" 0
  load_log
  assert_contains "${log}" "(tag: v0.0.1) Merge branch 'fix1' into main-0"
  assert_contains "${log}" "(HEAD -> main-0, tag: v0.0.2) Merge branch 'hotfix-$(whoami)' into main-0"
  assert_equal "$(git show main-0:VERSION)" "0.0.2"
  assert_equal "$(git show main:VERSION)" "1.0.0"
  assert_equal "$(git show main-1:VERSION)" "1.0.0"
  assert_equal "$(git show dev:VERSION)" "1.1.0"
  assert_equal "$(git log --oneline main..main-0 | grep -c "Merge branch")" 2
  assert_equal "$(git tag --merged dev | grep -c "^v0\.0\.[12]$")" 0
  assert_equal "$(git show-ref | grep "/refs/heads/\(fix1\|hotfix-\)")" ""
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "merge hotfix keeps one changelog link per version on dev"
  take "${i}"
  { flow -iy \
    && gch main \
    && flow --yes myhotfix \
    && echo a > a \
    && git add . \
    && git commit -m "add file a" \
    && echo '' | flow --yes \
    && gch main \
    && flow --yes myhotfix \
    && sed -i 's/^\[0.0.1\]: .*/[0.0.1]: repaired link/' CHANGELOG.md \
    && git commit -am "repair link"
  } >/dev/null
  debug "echo '' | flow --yes"
  assert_equal "${status}" 0
  links="[Unreleased]: git diff staging..dev
[0.0.2]: git diff v0.0.1..v0.0.2
[0.0.1]: repaired link
[0.0.0]: git log v0.0.0"
  assert_equal "$(git show dev:CHANGELOG.md | grep '^\[')" "${links}"
  assert_equal "$(git show dev:CHANGELOG.md | tail -n 4)" "${links}"
  assert_equal "$(gsp)" ""
end
#######################################
: $((i++))
start "merge hotfix with unmerged staging"
  take "${i}"
  { flow -iy \
   && flow --yes \
   && flow --yes --branch main \
   && echo b > b \
   && git add . \
   && git commit -m "add file b"
  } >/dev/null
  # assume conflicts
  debug "echo '' | flow --yes"
  assert_equal "${status}" 0
  load_log
  assert_contains "${loglines[0]}" "(HEAD -> dev) Merge branch 'staging' into dev"
  assert_contains "${log}" "(tag: v0.0.1, main-0, main) Merge branch 'hotfix-$(whoami)'"
  assert_equal "$(git show staging:b)" "b"
  assert_equal "$(git show dev:VERSION)" "0.2.0"
  assert_equal "$(git show staging:VERSION)" "0.1.0"
  assert_equal "$(git show main:VERSION)" "0.0.1"
  assert_equal "$(git show-ref | grep /refs/heads/hotfix-myhotfix)" ""
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "merge staging into dev with conflicts"
  take "${i}"
  {
    flow -iy \
    && flow --yes \
    && git checkout dev \
    && echo "dev content" > a \
    && git add a \
    && git commit -m "Update file 'a' in dev" \
    && git checkout staging \
    && echo "staging content" > a \
    && git add a \
    && git commit -m "Update file 'a' in staging" \
    && git checkout dev
  } >/dev/null 2>&1
  debug "flow --yes --conform"
  assert_equal "${status}" 7
  assert_equal "${errlines[0]}" "flow: error: Committing is not possible because you have unmerged files."
end
#######################################
## Branch option and new branch names
#######################################
: $((i++))
start "feature and hotfix are too generic names"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --yes feature"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch name 'feature' is too generic."
  debug "flow --yes -b main hotfix"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch name 'hotfix' is too generic."
  debug "flow --yes Feature"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch name 'Feature' is too generic."
  assert_equal "$(git_current_branch)" "dev"
  assert_equal "$(git show-ref | wc -l)" 5
end
#######################################
: $((i++))
start "existing name is not created again"
  take "${i}"
  { flow -iy \
    && flow --yes myfeature \
    && gch dev
  } >/dev/null
  debug "flow --yes myfeature"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch 'myfeature' already exists; to advance it, run 'flow --branch myfeature'."
  debug "flow --yes main"
  assert_equal "${status}" 2
  assert_contains "${errlines[0]}" "Branch 'main' already exists"
  assert_equal "$(git_current_branch)" "dev"
end
#######################################
: $((i++))
start "key branch names are reserved"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --yes master"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch name 'master' is reserved for a key branch."
  debug "flow --yes main-5"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch name 'main-5' is reserved for a key branch."
  assert_equal "$(git show-ref | wc -l)" 5
end
#######################################
: $((i++))
start "no branch is created from staging"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --yes -b staging myfeature"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: No branch can be created from 'staging'."
  assert_equal "$(git show-ref | wc -l)" 5
end
#######################################
: $((i++))
start "branch option needs an existing branch"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --yes -b nosuch"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch 'nosuch' not found."
  assert_equal "$(git show-ref | wc -l)" 5
end
#######################################
: $((i++))
start "branch option resolves key branch aliases"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --yes --branch develop"
  assert_equal "${status}" 0
  assert_equal "$(git show staging:VERSION)" "0.1.0"
  assert_equal "$(git show dev:VERSION)" "0.2.0"
end
#######################################
: $((i++))
start "new feature from a feature branch"
  take "${i}"
  { flow -iy \
    && flow --yes feature1 \
    && echo a > a \
    && git add . \
    && git commit -m "add file a"
  } >/dev/null
  debug "flow --yes feature2"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "feature2"
  assert_equal "$(git rev-parse feature2)" "$(git rev-parse dev)"
end
#######################################
: $((i++))
start "new hotfix from a hotfix branch"
  take "${i}"
  { flow -iy \
    && gch main \
    && flow --yes fix1 \
    && echo a > a \
    && git add . \
    && git commit -m "add file a"
  } >/dev/null
  debug "flow --yes fix2"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "fix2"
  assert_equal "$(git rev-parse fix2)" "$(git rev-parse main)"
end
#######################################
: $((i++))
start "merge feature with --branch from another branch"
  take "${i}"
  { flow -iy \
    && flow --yes myfeature \
    && echo a > a \
    && git add . \
    && git commit -m "add feature 1" \
    && gch main
  } >/dev/null
  debug "echo 'feature1' | flow --yes -b myfeature"
  assert_equal "${status}" 0
  assert_contains "$(git log --oneline -1 dev)" "Merge branch 'myfeature' into dev"
  assert_equal "$(git show-ref | grep /refs/heads/myfeature)" ""
end
#######################################
: $((i++))
start "default hotfix is not created twice"
  take "${i}"
  { flow -iy \
    && gch main \
    && flow --yes \
    && gch main
  } >/dev/null
  debug "flow --yes"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch 'hotfix-$(whoami)' already exists; to advance it, run 'flow --branch hotfix-$(whoami)'."
  assert_equal "$(git_current_branch)" "main"
end
#######################################
: $((i++))
start "what now with --branch"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow -w -b main"
  assert_equal "${status}" 0
  assert_contains "${stdout}" "* Flow on 'main'"
  assert_contains "${stdout}" "to create hotfix 'hotfix-$(whoami)'"
  assert_equal "$(git_current_branch)" "dev"
end
#######################################
: $((i++))
start "open hotfix survives releasing staging"
  take "${i}"
  { flow -iy \
    && echo a > a \
    && git add . \
    && git commit -m "add file a" \
    && flow --yes \
    && flow --yes -b dev myfeature \
    && flow --yes --branch main \
    && echo b > b \
    && git add . \
    && git commit -m "add file b"
  } >/dev/null
  debug "flow --yes -b staging"
  assert_equal "${status}" 0
  assert_equal "$(git show main:VERSION)" "0.1.0"
  debug "echo '' | flow --yes -b hotfix-$(whoami)"
  assert_equal "${status}" 0
  assert_equal "$(git show main:VERSION)" "0.1.1"
  assert_equal "$(git show main:b)" "b"
  assert_equal "$(git show dev:VERSION)" "0.2.0"
  assert_contains "$(git show-ref)" "refs/heads/myfeature"
  assert_equal "$(gsp)" ""
end
#######################################
: $((i++))
start "invalid new branch names"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --yes a..b"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Invalid branch name 'a..b'."
  debug "flow --yes HEAD"
  assert_equal "${status}" 2
  debug "flow --yes -- -x"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Invalid branch name '-x'."
  assert_equal "$(git show-ref | wc -l)" 5
end
#######################################
: $((i++))
start "dry run with a new branch name creates nothing"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow -n newfeature"
  assert_equal "${status}" 0
  assert_equal "$(git show-ref | grep -c /refs/heads/newfeature)" 0
  assert_equal "$(git_current_branch)" "dev"
end
#######################################
: $((i++))
start "name and branch cannot be combined with pull, push, init or what now"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow --pull newfeature"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: NAME cannot be combined with --pull, --push, --init or --what-now."
  debug "flow -w newfeature"
  assert_equal "${status}" 2
  debug "flow --push -b dev"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Option --branch cannot be combined with --pull, --push or --init."
end
#######################################
: $((i++))
start "what now with a missing branch"
  take "${i}"
  { flow -iy; } >/dev/null
  debug "flow -w -b nosuch"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch 'nosuch' not found."
  assert_equal "${stdout}" ""
end
#######################################
: $((i++))
start "new feature with --branch on a feature from another branch"
  take "${i}"
  { flow -iy \
    && flow --yes feature1 \
    && echo a > a \
    && git add . \
    && git commit -m "add file a" \
    && gch main
  } >/dev/null
  debug "flow --yes -b feature1 feature2"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "feature2"
  assert_equal "$(git rev-parse feature2)" "$(git rev-parse dev)"
end
#######################################
: $((i++))
start "parallel hotfixes are both released as hotfixes"
  take "${i}"
  { flow -iy \
    && flow --yes -b main fix1 \
    && echo a > a \
    && git add . \
    && git commit -m "add file a" \
    && flow --yes fix2 \
    && echo b > b \
    && git add . \
    && git commit -m "add file b" \
    && echo '' | flow --yes -b fix1
  } >/dev/null
  debug "echo '' | flow --yes -b fix2"
  assert_equal "${status}" 0
  assert_equal "$(git show main:VERSION)" "0.0.2"
  assert_equal "$(git show main:b)" "b"
  assert_equal "$(git show dev:VERSION)" "0.1.0"
  assert_contains "$(git tag)" "v0.0.2"
  assert_equal "$(git show-ref | grep "/refs/heads/fix")" ""
  assert_equal "$(gsp)" ""
  debug "flow -n"
  assert_equal "${status}" 0
end
#######################################
: $((i++))
start "new hotfix from a hotfix on an older major"
  take "${i}"
  { flow -iy \
   && echo 1.0.0 > VERSION \
   && git commit -am "bump version" \
   && flow -y -b dev \
   && flow -y \
   && gch main-0 \
   && flow --yes fix1 \
   && echo a > a \
   && git add . \
   && git commit -m "add file a"
  } >/dev/null
  debug "flow --yes fix2"
  assert_equal "${status}" 0
  assert_equal "$(git_current_branch)" "fix2"
  assert_equal "$(git rev-parse fix2)" "$(git rev-parse main-0)"
end
#######################################
: $((i++))
start "hotfix on an older major survives releasing staging"
  take "${i}"
  { flow -iy \
   && echo 1.0.0 > VERSION \
   && git commit -am "bump version" \
   && flow -y -b dev \
   && flow -y \
   && gch main-0 \
   && flow --yes oldfix \
   && echo a > a \
   && git add . \
   && git commit -m "add file a" \
   && flow -y -b dev
  } >/dev/null
  debug "flow --yes -b staging"
  assert_equal "${status}" 0
  assert_equal "$(git show main:VERSION)" "1.1.0"
  debug "flow -w -b oldfix"
  assert_contains "${stdout}" "temporary hotfix branch"
end
#######################################
: $((i++))
start "branches that exist only on origin"
  take "${i}"
  { git init -q --bare ../"${i}"-origin.git \
    && flow -iy \
    && git remote add origin ../"${i}"-origin.git \
    && git push -q origin --all \
    && flow --yes -b main rfix \
    && echo a > a \
    && git add . \
    && git commit -qm "add file a" \
    && git push -q origin rfix \
    && gch dev \
    && git branch -qD rfix \
    && echo b > b \
    && git add . \
    && git commit -qm "add file b" \
    && flow --yes
  } >/dev/null 2>&1
  debug "flow --yes -b dev rfix"
  assert_equal "${status}" 2
  assert_contains "${errlines[0]}" "Branch 'rfix' already exists"
  debug "flow -n -b origin/rfix"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Branch 'origin/rfix' not found."
  debug "flow -w -b rfix"
  assert_equal "${status}" 0
  assert_contains "${stdout}" "temporary hotfix branch"
end
#######################################
: $((i++))
start "detached HEAD"
  take "${i}"
  { flow -iy \
    && git checkout -q --detach dev
  } >/dev/null
  debug "flow -b dev"
  assert_equal "${status}" 2
  assert_equal "${errlines[0]}" "flow: Detached HEAD; check out a branch first."
end
